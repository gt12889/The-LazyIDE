{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lazygt",
  "version": "0.1.19",
  "identifier": "com.lazygt.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "lazygt",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* ipc: http://ipc.localhost; frame-src 'self' http://localhost:* http://127.0.0.1:*;"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lazygt"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/node.exe": "resources/node.exe",
      "resources/lazybrain/lazybrain.js": "resources/lazybrain/lazybrain.js",
      "resources/lazybrain/package.json": "resources/lazybrain/package.json",
      "resources/lazybrain/node_modules": "resources/lazybrain/node_modules",
      "resources/brain-mcp/brain-search-server.mjs": "resources/brain-mcp/brain-search-server.mjs"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
